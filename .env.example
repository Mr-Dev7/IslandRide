# ==============================================================================
# IslandRide — Environment Configuration Example (.env.example)
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Runtime Profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# MySQL Database (Docker / Local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=islandride_db
MYSQL_USER=islandride_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password

# Redis Cache & Ephemeral Coordination
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_local

# Security & JWT Tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=local_minio_access_key
S3_SECRET_KEY=local_minio_secret_key
S3_BUCKET_PUBLIC_MEDIA=islandride-public-media
S3_BUCKET_PRIVATE_DOCS=islandride-private-documents

# Payment Gateway (Razorpay Sandbox Credentials)
PAYMENT_GATEWAY_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret

# Notification Providers (Optional in local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@islandride.in

